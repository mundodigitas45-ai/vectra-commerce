        "id": "93589a59-151b-4128-9b5b-e64d8c81cc8d",
        "name": "API - Concluir Imagem",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2380,
          80
        ]
      },
      {
        "parameters": {
          "jsCode": "let source = {};\n\ntry {\n  source =\n    $('Preparar Criativo Visual').first().json;\n} catch {}\n\nconst incoming = $json || {};\n\nconst error =\n  incoming.error ||\n  incoming.cause ||\n  incoming;\n\nconst message = String(\n  error.message ||\n  error.description ||\n  error.error?.message ||\n  'Falha não identificada na geração do fundo visual.'\n).slice(0, 2000);\n\nif (!source.job?.id) {\n  throw new Error(\n    'Não foi possível identificar o job visual com falha: ' +\n    message\n  );\n}\n\nconst isRateLimited =\n  /too many requests|rate limit|http 429/i.test(\n    message\n  );\n\nreturn [{\n  json: {\n    job_id:\n      source.job.id,\n    worker_id:\n      source.worker_id ||\n      'n8n-central-criativos-imagens-identity-lock-v3',\n    error_code:\n      isRateLimited\n        ? 'OPENAI_IMAGE_RATE_LIMITED'\n        : 'OPENAI_BACKGROUND_GENERATION_FAILED',\n    error_message:\n      message,\n    output: {\n      failed_at:\n        new Date().toISOString(),\n      format_key:\n        source.format?.key || null,\n      visual_mode:\n        source.visual_mode || null,\n      composition_mode:\n        source.composition_mode || null,\n      pipeline:\n        'identity-lock-v3',\n      details:\n        message\n    }\n  }\n}];"
        },
