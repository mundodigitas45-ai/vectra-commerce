        "id": "bab3c7d2-9726-4c2f-8ad0-15894bf274a7",
        "name": "API - Reservar Job de Imagem",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -760,
          80
        ]
      },
      {
        "parameters": {
          "jsCode": "const envelope = $json;\n\nif (!envelope || envelope.success !== true) {\n  throw new Error(\n    'A API não confirmou a reserva do job visual.'\n  );\n}\n\nif (envelope.empty || !envelope.data) {\n  return [];\n}\n\nconst data = envelope.data;\n\nif (\n  !data.job?.id ||\n  !data.channel?.id ||\n  !data.format?.key ||\n  !data.approved_copy?.content\n) {\n  throw new Error(\n    'O job visual reservado está incompleto.'\n  );\n}\n\nreturn [{ json: data }];"
        },
        "id": "6c50ef46-bfca-421e-b46b-ae7054a7df6a",
        "name": "Validar Job de Imagem",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -520,
          80
        ]
      },
      {
        "parameters": {
          "jsCode": "const data = $json;\nconst format = data.format || {};\nconst product = data.product || {};\n\nconst sizes = {\n  square: '1024x1024',\n  feed_portrait: '1024x1536',\n  story: '1024x1536',\n  landscape: '1536x1024'\n};\n\nconst formatNames = {\n  square: 'quadrado',\n  feed_portrait: 'vertical para feed',\n  story: 'vertical para Stories ou Reels',\n  landscape: 'horizontal'\n};\n\nconst media = Array.isArray(data.product_media)\n  ? data.product_media\n  : [];\n\nconst officialMedia = media\n  .filter(item =>\n    /^https:\\/\\/.+/i.test(\n      String(item.public_url || '').trim()\n    )\n  )\n  .sort((left, right) =>\n    Number(Boolean(right.is_primary)) -\n    Number(Boolean(left.is_primary))\n  );\n\nconst primaryReference = officialMedia[0];\n\nif (!primaryReference) {\n  throw new Error(\n    'CREATIVE_IMAGE_REAL_REFERENCE_REQUIRED: ' +\n    'cadastre uma foto real oficial do produto.'\n  );\n}\n\nconst referenceUrl = String(\n  primaryReference.public_url\n).trim();\n\nconst prompt = [\n  'Crie somente um fundo publicitário premium para comércio eletrônico.',\n  'Não desenhe, recrie, represente ou insira nenhum produto.',\n  'Não insira embalagem, cabo, carregador, fone, acessório ou objeto comercial.',\n  'Não insira logotipo, marca, letras, números, preço, selo, CTA ou texto.',\n  'Não use pessoas, mãos ou elementos que ocupem a área central.',\n  'Mantenha a região central livre para receber posteriormente a fotografia real do produto.',\n  'Reserve áreas limpas no topo e na parte inferior para a composição comercial.',\n  'Use fundo elegante preto e grafite com iluminação dourada discreta.',\n  'Visual premium, realista, limpo, profissional e com alto contraste.',\n  'Evite excesso de brilho, raios, partículas, molduras e poluição visual.',\n  'Formato: ' +\n    (formatNames[format.key] || format.key) +\n    '.',\n  'Dimensão final esperada: ' +\n    format.width + 'x' + format.height + '.',\n  'Entregue exclusivamente o fundo sem produto e sem texto.'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...data,\n    worker_id:\n      'n8n-central-criativos-imagens-identity-lock-v3',\n    visual_mode:\n      'background_only_identity_lock',\n    composition_mode:\n      'identity_lock_v3',\n    pipeline_version:\n      'identity-lock-v3',\n    image_prompt:\n      prompt,\n    reference_image_url:\n      referenceUrl,\n    reference_urls: [\n      referenceUrl\n    ],\n    reference_inventory: [{\n      order: 1,\n      role:\n        'official_product_identity',\n      url:\n        referenceUrl,\n      alt_text:\n        String(\n          primaryReference.alt_text || ''\n        ).trim() || null,\n      is_primary:\n        Boolean(\n          primaryReference.is_primary\n        ),\n      product_id:\n        product.id ||\n        data.campaign?.product_id ||\n        null\n    }],\n    openai_request: {\n      model: 'gpt-5.4',\n      input: [{\n        role: 'user',\n        content: [{\n          type: 'input_text',\n          text: prompt\n        }]\n      }],\n      tools: [{\n        type: 'image_generation',\n        quality: 'high',\n        size:\n          sizes[format.key] ||\n          '1024x1024'\n      }]\n    }\n  }\n}];"
        },
        "id": "48d63972-3795-4af3-aedb-fbfbd48f8404",
        "name": "Preparar Criativo Visual",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -280,
