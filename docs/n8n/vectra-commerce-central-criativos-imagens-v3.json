        "id": "18a22e69-a137-4cfc-a758-f54d1315ec6c",
        "name": "OpenAI - Gerar Imagem Tentativa 1",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -20,
          80
        ],
        "credentials": {
          "openAiApi": {
            "id": "6YAdIl0TV2nxtvl5",
            "name": "OpenAi account"
          }
        },
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "jsCode": "const source =\n  $('Preparar Criativo Visual').first().json;\n\nconst response = $json;\n\nconst calls = Array.isArray(response.output)\n  ? response.output.filter(\n      item =>\n        item &&\n        item.type === 'image_generation_call' &&\n        typeof item.result === 'string'\n    )\n  : [];\n\nif (!calls.length) {\n  const message =\n    response.error?.message ||\n    response.output_text ||\n    'A OpenAI não retornou o fundo visual.';\n\n  throw new Error(message);\n}\n\nconst imageBase64 = calls[0].result;\n\nif (imageBase64.length < 100) {\n  throw new Error(\n    'O fundo retornado está vazio ou inválido.'\n  );\n}\n\nif (!source.reference_image_url) {\n  throw new Error(\n    'CREATIVE_IMAGE_REAL_REFERENCE_REQUIRED: ' +\n    'a foto oficial não foi preservada.'\n  );\n}\n\nif (\n  source.composition_mode !==\n  'identity_lock_v3'\n) {\n  throw new Error(\n    'CREATIVE_IMAGE_COMPOSITION_MODE_INVALID'\n  );\n}\n\nreturn [{\n  json: {\n    job_id:\n      source.job.id,\n    worker_id:\n      source.worker_id,\n    channel_id:\n      source.channel.id,\n    format_key:\n      source.format.key,\n    image_base64:\n      imageBase64,\n    reference_image_url:\n      source.reference_image_url,\n    composition_mode:\n      source.composition_mode,\n    prompt:\n      source.image_prompt,\n    content: {\n      headline:\n        source.approved_copy?.content\n          ?.headline || null,\n      primary_text:\n        source.approved_copy?.content\n          ?.primary_text || null,\n      description:\n        source.approved_copy?.content\n          ?.description || null,\n      cta:\n        source.approved_copy?.content\n          ?.cta ||\n        'PEÇA PELO WHATSAPP'\n    },\n    metadata: {\n      generator:\n        'openai-responses-image-generation',\n      pipeline:\n        'identity-lock-v3',\n      visual_mode:\n        source.visual_mode,\n      composition_mode:\n        source.composition_mode,\n      generated_asset_role:\n        'background_only',\n      product_redrawn_by_ai:\n        false,\n      real_product_composition:\n        'deterministic_api_compositor',\n      generation_response_id:\n        response.id || null,\n      generation_response_model:\n        response.model || 'gpt-5.4',\n      generation_usage:\n        response.usage || null,\n      reference_image_url:\n        source.reference_image_url,\n      reference_inventory:\n        source.reference_inventory,\n      requested_width:\n        source.format.width,\n      requested_height:\n        source.format.height\n    },\n    output: {\n      openai_response_id:\n        response.id || null,\n      generated_asset_role:\n        'background_only',\n      composed_with_real_product:\n        true,\n      generated_at:\n        new Date().toISOString()\n    }\n  }\n}];"
        },
